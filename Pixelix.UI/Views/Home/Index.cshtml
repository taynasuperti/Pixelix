@using System.Linq
@model Pixelix.UI.ViewModels.HomeVM

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- CARROSSEL FULL-WIDTH -->
<!-- CARROSSEL FULL -->
<div id="homeCarousel" class="carousel slide home-carousel" data-bs-ride="carousel">

    <h2 class="carousel-title">A Melhor Opção Para o SEU Jogo</h2>

    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/img/carrossel/carrossel-teste.jpg" class="carousel-img" />
        </div>
        <div class="carousel-item">
            <img src="~/img/carrossel/carrossel-teste.jpg" class="carousel-img" />
        </div>
        <div class="carousel-item">
            <img src="~/img/carrossel/carrossel-teste.jpg" class="carousel-img" />
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>


<div class="container mt-5">

 <!-- CARDS DESCONTO - AGORA DINÂMICOS -->
<div class="row mt-4 g-4">

    @foreach (var produto in Model.ProdutosDestaque)
    {
        <div class="col-md-4">
            <div class="discount-card p-3 position-relative">

                <span class="discount-badge">80% OFF</span>

                <div class="discount-img-wrapper">
                    <img src="@produto.Foto" />
                </div>

                <h5 class="text-white mt-3 fw-bold">
                    @produto.Nome
                </h5>

                <button class="discount-btn mt-2 w-100">VER MAIS</button>
            </div>
        </div>
    }

    @* Caso não tenha nenhum produto *@
    @if (!Model.ProdutosDestaque.Any())
    {
        <p class="text-white">Nenhum produto em destaque encontrado.</p>
    }
</div>


    <!-- SPRITES EM ALTA -->
    <div class="pixel-title mt-5">SPRITES EM ALTA</div>

    <!-- CARDS HOT -->
<div class="row g-4 mt-3">

    @foreach (var produto in Model.ProdutosDestaque.Take(3))
    {
        <div class="col-md-4">
            <div class="hot-card">
                <div class="position-relative">

                    <img src="@produto.Foto" class="hot-img" />

                    <span class="hot-price-tag">
                        @produto.ValorVenda.ToString("C")
                    </span>
                </div>

                <p class="hot-card-title">
                    @produto.Nome
                </p>
            </div>
        </div>
    }

    @if (!Model.ProdutosDestaque.Any())
    {
        <p class="text-white">Nenhum sprite em alta no momento.</p>
    }
</div>

</div>
