@model SpritesViewModel
@using Pixelix.API.Models
@{
    ViewData["Title"] = "Sprites";
}

<!-- Segunda navbar hamburguer (filtros) -->
<section class="sprite-filter-navbar px-4 py-3" style="background-color: #B898D0;">
    <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold" style="color: #3F1662; font-family: 'Pixelify Sans', sans-serif;">Filtrar</h5>
        <button id="toggleFilterBtn" class="btn" style="background-color: #9456c4; color: #000000; border-radius: 10px;">
            <i class="bi bi-list fs-4"></i>
        </button>
    </div>

    <div id="filterMenu" class="mt-3 d-none">
        <div class="filter-menu-content p-3 rounded" style="background-color: #ecd4ff;">
            <h5 class="filter-title mb-3">Categorias</h5>

            @foreach (var categoria in Model.Categorias)
            {
                <div class="filter-group mb-3">
                    <p class="filter-category fw-semibold">@categoria.Nome</p>
                    <ul class="ps-3">
                        @if (categoria.Subcategorias != null && categoria.Subcategorias.Any())
                        {
                            @foreach (var sub in categoria.Subcategorias)
                            {
                                <li>@sub</li>
                            }
                        }
                        else
                        {
                            <li class="text-muted">Sem subcategorias</li>
                        }
                    </ul>
                </div>
            }

            <button class="btn btn-outline-dark mt-2">Mais Categorias</button>
        </div>
    </div>
</section>

<!-- Título da seção -->
<h2 class="pixel-title mt-5 mb-4 text-center">Todos os Sprites disponíveis</h2>

<!-- Cards dos sprites -->
<div class="container">
    <div class="row g-4">
        @foreach (var produto in Model.Produtos)
        {
            <div class="col-md-4">
                <div class="hot-card position-relative">
                    <img src="@produto.FotoUrl" alt="@produto.Nome" class="hot-img" />
                    <div class="hot-price-tag">R$ @produto.ValorVenda.ToString("F2")</div>
                    <h5 class="hot-card-title">@produto.Nome</h5>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/site.css">
}

@section Scripts {
    <script>
        document.getElementById("toggleFilterBtn").addEventListener("click", function () {
            const menu = document.getElementById("filterMenu");
            menu.classList.toggle("d-none");
        });
    </script>
}
