@model Pixelix.UI.ViewModels.SpritesPageVM
@{
    ViewData["Title"] = "Sprites";
}

<!-- Segunda navbar hamburguer (filtros) -->
<section class="sprite-filter-navbar px-4 py-3">
    <div class="d-flex justify-content-between align-items-center">
        <button id="toggleFilterBtn" class="filter-toggle-btn">
            <i class="bi bi-list"></i>
        </button>
    </div>

<aside id="filterSidebar" class="filter-sidebar">
    <div class="filter-sidebar-content">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="filter-title mb-0">Categorias</h4>
            <button id="closeFilterBtn" class="close-filter-btn d-none">
                <i class="bi bi-list"></i>
            </button>
        </div>

        @foreach (var categoria in Model.Categorias)
        {
            <p class="filter-category">@categoria.Nome</p>
        }

        <div class="mais-categorias-btn mt-3">
            <i class="bi bi-plus-circle"></i>
            <span>Mais Categorias</span>
        </div>
    </div>
</aside>

</section>

<!-- Título da seção -->
<div class="pixel-banner">
    <h2 class="pixel-banner-text">
        Dê vida aos seus pixels! Heróis, monstros e mundos prontos para o seu próximo game.
    </h2>
</div>


<!-- Cards dos sprites -->
<div class="container">
    <div class="row g-4 mt-3">
        <div class="col-md-4">
            <a asp-controller="Sprites" asp-action="Detalhes" asp-route-id="1" class="text-decoration-none">
                <div class="hot-card">
                    <div class="position-relative">
                        <img src="~/img/sprites-teste.jpg" class="hot-img" />
                        <span class="hot-price-tag">R$ 240,00</span>
                    </div>
                    <p class="hot-card-title">Diversidade de pássaros 2D<br>1.300 sprites para o seu jogo</p>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Sprites" asp-action="Detalhes" asp-route-id="2" class="text-decoration-none">
                <div class="hot-card">
                    <div class="position-relative">
                        <img src="~/img/sprites-teste.jpg" class="hot-img" />
                        <span class="hot-price-tag">R$ 120,99</span>
                    </div>
                    <p class="hot-card-title">Doces e guloseimas 2D<br>+ de 130 sprites deliciosos!</p>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Sprites" asp-action="Detalhes" asp-route-id="3" class="text-decoration-none">
                <div class="hot-card">
                    <div class="position-relative">
                        <img src="~/img/sprites-teste.jpg" class="hot-img" />
                        <span class="hot-price-tag">R$ 98,90</span>
                    </div>
                    <p class="hot-card-title">Espadas personalizadas para<br>jogos 2D</p>
                </div>
            </a>
        </div>
    </div>
</div>



@section Styles {
    <link rel="stylesheet" href="~/css/site.css">
}

@section Scripts {
    <script>
        const toggleBtn = document.getElementById("toggleFilterBtn");
        const closeBtn = document.getElementById("closeFilterBtn");
        const sidebar = document.getElementById("filterSidebar");

        toggleBtn.addEventListener("click", () => {
            sidebar.classList.add("active");
            toggleBtn.classList.add("d-none");
            closeBtn.classList.remove("d-none");
        });

        closeBtn.addEventListener("click", () => {
            sidebar.classList.remove("active");
            toggleBtn.classList.remove("d-none");
            closeBtn.classList.add("d-none");
        });
    </script>
}
