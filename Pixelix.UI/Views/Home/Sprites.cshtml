@model Pixelix.UI.ViewModels.SpritesPageVM
@{
    ViewData["Title"] = "Sprites";
}

<!-- Segunda navbar hamburguer (filtros) -->
<section class="sprite-filter-navbar px-4 py-3" style="background-color: #B898D0;">
    <div class="d-flex justify-content-between align-items-center">
        <button id="toggleFilterBtn" class="filter-toggle-btn">
            <i class="bi bi-list"></i>
        </button>
    </div>

<aside id="filterSidebar" class="filter-sidebar">
    <div class="filter-sidebar-content">
        <h4 class="filter-title">Categorias</h4>

            @foreach (var categoria in Model.Categorias)
            {
                <p class="filter-category">@categoria.Nome</p>

            }

<div class="mais-categorias-btn mt-3">
    <i class="bi bi-plus-circle-fill"></i>
    <span>Mais Categorias</span>
</div>
        </div>
    </div>
</aside>

<!-- Título da seção -->
<h2 class="pixel-title text-center mb-4">Dê vida aos seus pixels! Heróis, monstros e mundos prontos para o seu próximo
    game. </h2>

<!-- Cards dos sprites -->
<div class="container">
    <div class="row g-4">
        @foreach (var produto in Model.Produtos)
        {
            <div class="col-md-4">
                <div class="hot-card position-relative">
                    <img src="@produto.Foto" alt="@produto.Nome" class="hot-img" />
                    <div class="hot-price-tag">R$ @produto.ValorVenda.ToString("F2")</div>
                    <h5 class="hot-card-title">@produto.Nome</h5>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/site.css">
}

@section Scripts {
    <script>
        const toggleBtn = document.getElementById("toggleFilterBtn");
        const sidebar = document.getElementById("filterSidebar");

        toggleBtn.addEventListener("click", () => {
            sidebar.classList.toggle("active");
        });
    </script>
}