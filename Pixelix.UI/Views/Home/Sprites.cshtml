@model Pixelix.UI.ViewModels.SpritesPageVM
@{
    ViewData["Title"] = "Sprites";
}

<!-- Segunda navbar hamburguer (filtros) -->
<section class="sprite-filter-navbar px-4 py-3">
    <div class="d-flex justify-content-between align-items-center">
        <button id="toggleFilterBtn" class="filter-toggle-btn">
            <i class="bi bi-list"></i>
        </button>
    </div>

<aside id="filterSidebar" class="filter-sidebar">
    <div class="filter-sidebar-content">
        <div class="d-flex justify-content-between align-items-center mb-3">
<a asp-controller="Home"
       asp-action="Sprites"
       class="filter-title mb-0">
        Categorias
    </a>            <button id="closeFilterBtn" class="close-filter-btn d-none">
                <i class="bi bi-list"></i>
            </button>
        </div>

        @foreach (var categoria in Model.Categorias)
        {
            <a asp-controller="Home"
            asp-action="Sprites"
            asp-route-categoriaId="@categoria.Id"
            class="filter-category @(ViewBag.CategoriaSelecionada == categoria.Id ? "active" : "")">
                @categoria.Nome
            </a>
        }




        <a asp-controller="Home"
       asp-action="Sprites"
       class="mais-categorias-btn mt-3">
        <i class="bi bi-plus-circle"></i>
        <span>Mais Categorias</span>
    </a>
    </div>
</aside>

</section>

<!-- Título da seção -->
<div class="pixel-banner">
    <h2 class="pixel-banner-text">
        Dê vida aos seus pixels! Heróis, monstros e mundos prontos para o seu próximo game.
    </h2>
</div>


<!-- Cards dos sprites -->
<div class="container">
    <div class="row g-4 mt-3">
@foreach (var produto in Model.Produtos)
    {
        <div class="col-md-4">
            <div class="discount-card p-3 position-relative">

                <span class="discount-badge">80% OFF</span>

                <a asp-controller="Home"
   asp-action="Detalhes"
   asp-route-id="@produto.Id"
   class="discount-img-wrapper">
    <img src="@produto.Foto" />
</a>


                <h5 class="text-white mt-3 fw-bold">
                    @produto.Nome
                </h5>

                <a asp-controller="Home"
                asp-action="Detalhes"
                asp-route-id="@produto.Id"
                class="discount-btn mt-2 w-100">
                    VER MAIS
                </a>
            </div>
        </div>
    }            
    </div>

        
    </div>
</div>



@section Styles {
    <link rel="stylesheet" href="~/css/site.css">
}

@section Scripts {
    <script>
        const toggleBtn = document.getElementById("toggleFilterBtn");
        const closeBtn = document.getElementById("closeFilterBtn");
        const sidebar = document.getElementById("filterSidebar");

        toggleBtn.addEventListener("click", () => {
            sidebar.classList.add("active");
            toggleBtn.classList.add("d-none");
            closeBtn.classList.remove("d-none");
        });

        closeBtn.addEventListener("click", () => {
            sidebar.classList.remove("active");
            toggleBtn.classList.remove("d-none");
            closeBtn.classList.add("d-none");
        });
    </script>
}
