@{
    string activeMenu(string link) => ViewBag.Menu == link ? "active-link" : "";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pixelix - @ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="~/css/admin-pixelix.css" />
    @await RenderSectionAsync("Styles", false)
</head>

<body style="background-color: var(--px-bg); font-family: 'Pixelify Sans', sans-serif;">

    <!-- NAVBAR SUPERIOR -->
    <nav class="pixelix-navbar d-flex align-items-center justify-content-between px-4">
        <a asp-controller="Home" asp-action="Index" class="pixelix-logo d-flex align-items-center">
            <img src="~/img/logo/Pixelix.png" alt="Pixelix" class="pixelix-logo-img" />
        </a>

        <div class="dropdown">
            <button class="pixelix-icon-btn dropdown-toggle bg-transparent border-0 p-0"
                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-controller="Auth" asp-action="MinhaConta"><i class="bi bi-person"></i> Minha Conta</a></li>
                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Área Administrativa</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                        <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right"></i> Sair</button>
                    </form>
                </li>
            </ul>
        </div>
    </nav>

    <!-- SIDEBAR LATERAL ESTILIZADA -->
    <div class="filter-sidebar active">
        <button class="close-filter-btn" onclick="document.querySelector('.filter-sidebar').classList.remove('active')">
            <i class="bi bi-x-lg"></i>
        </button>

        <div class="filter-title">Administração</div>

        <div class="filter-group">
            <div class="filter-category">Navegação</div>
            <ul class="filter-sublist">
                <li><a asp-controller="Admin" asp-action="Index" class= "@activeMenu("Admin")">Dashboard</a></li>
                <li><a asp-controller="Clientes" asp-action="Index" class="@activeMenu("Clientes") ">Clientes</a></li>
                <li><a asp-controller="Produtos" asp-action="Index" class="@activeMenu("Produtos")">Produtos</a></li>
                <li><a asp-controller="Categorias" asp-action="Index" class="@activeMenu("Categorias")">Categorias</a></li>
                <li><a asp-controller="Usuarios" asp-action="Index" class="@activeMenu("Usuarios")">Usuários</a></li>
            </ul>
        </div>
    </div>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="main-content" style="margin-left: 300px; padding: 30px;">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js"></script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
